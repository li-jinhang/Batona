{
  "name": "dsh-remote-gateway",
  "version": "0.1.32",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness 手机远程接入网关（Phase 1 MVP）",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/app.ts",
    "start:prod": "node dist/app.mjs",
    "build": "esbuild src/app.ts --bundle --platform=node --format=esm --outfile=dist/app.mjs --external:ws",
    "typecheck": "tsc --noEmit",
    "smoke": "node test/smoke.ts",
    "tunnel-protocol": "node test/tunnel-protocol.ts",
    "tunnel": "node test/tunnel-e2e.ts"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
