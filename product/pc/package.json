{
  "name": "batona-pc",
  "productName": "Batona PC",
  "version": "0.5.26",
  "description": "Batona PC — 在本机运行并连接多个 Coding Agent，供手机安全远程操控",
  "main": "main.js",
  "author": "Batona",
  "license": "MIT",
  "scripts": {
    "build:native-control": "node tools/native-codex-probe/build-control.cjs",
    "prestart": "npm run build:native-control",
    "prestart:codex-test": "npm run build:native-control",
    "start": "electron .",
    "start:codex-test": "set BATONA_CODEX_TEST_PROFILE=1&& electron .",
    "presmoke": "npm run build:native-control",
    "smoke": "set BATONA_SMOKE=1&& electron .",
    "smoke:codex-test": "set BATONA_CODEX_TEST_PROFILE=1&& set BATONA_SMOKE=1&& electron .",
    "test:runtime-profile": "node test/runtime-profile.test.js",
    "test:tunnel-client": "node test/tunnel-client.test.js",
    "test:dir-service": "node test/dir-service.test.js",
    "test:dsh-launcher": "node test/dsh-launcher.test.js",
    "test:codex-open": "node test/codex-open.test.js",
    "test:codex-transport": "node test/codex-shared-ws.test.js && node test/codex-progress.test.js && node test/codex-ungrouped.test.js",
    "test:codex-auth": "node test/codex-auth.test.js",
    "test:codex-handoff": "node test/codex-handoff.test.js && powershell.exe -NoProfile -NonInteractive -File test/native-handoff-ps51.ps1 && powershell.exe -NoProfile -NonInteractive -File test/native-handoff-stale-state.ps1",
    "test:codex-package": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File test/native-handoff-package.ps1",
    "test:codex-control-mode": "node test/codex-control-mode.test.js",
    "test:codex-shared-writes": "node test/codex-transport-mode.test.js && node test/codex-shared-write-routing.test.js",
    "test:native-control": "node test/native-thread-binding.test.js && node test/native-prompt.test.js && node test/native-model.test.js && node test/native-permission.test.js && node test/native-process-refresh.test.js",
    "test:software-status": "node test/software-status.test.js",
    "predist": "npm run build:native-control",
    "dist": "electron-builder",
    "test:ui": "electron test/ui.cjs"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.batona.pc",
    "productName": "Batona PC",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "access-client.js",
      "software-status.js",
      "codex-handoff.js",
      "codex-control-mode.js",
      "codex-bridge.js",
      "runtime-profile.js",
      "native-codex-control.js",
      "tools/native-codex-probe/native-thread-binding.js",
      "dir-service.js",
      "dsh-launcher.js",
      "preload.js",
      "renderer/**/*",
      "tunnel/**/*"
    ],
    "extraResources": [
      {
        "from": "build/native-codex-bound-sender.exe",
        "to": "native-codex-bound-sender.exe"
      },
      {
        "from": "tools/shared-transport-probe/native-handoff.ps1",
        "to": "native-handoff.ps1"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Batona PC"
    }
  }
}
