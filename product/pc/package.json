{
  "name": "dsh-link-pc",
  "productName": "DSH Link",
  "version": "0.3.6",
  "description": "DSH Link PC 端 — 一键启动 DeepSeek Harness 并接入服务器，手机随时远程操控",
  "main": "main.js",
  "author": "DSH Link",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "smoke": "set DSHLINK_SMOKE=1&& electron .",
    "test:tunnel-client": "node test/tunnel-client.test.js",
    "test:dir-service": "node test/dir-service.test.js",
    "test:dsh-launcher": "node test/dsh-launcher.test.js",
    "dist": "electron-builder"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dshlink.pc",
    "productName": "DSH Link",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "codex-bridge.js",
      "dir-service.js",
      "dsh-launcher.js",
      "preload.js",
      "renderer/**/*",
      "tunnel/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "DSH Link"
    }
  }
}
