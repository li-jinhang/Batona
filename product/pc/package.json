{
  "name": "batona-pc",
  "productName": "Batona PC",
  "version": "0.5.0",
  "description": "Batona PC — 在本机运行并连接多个 Coding Agent，供手机安全远程操控",
  "main": "main.js",
  "author": "Batona",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "smoke": "set BATONA_SMOKE=1&& electron .",
    "test:tunnel-client": "node test/tunnel-client.test.js",
    "test:dir-service": "node test/dir-service.test.js",
    "test:dsh-launcher": "node test/dsh-launcher.test.js",
    "test:codex-open": "node test/codex-open.test.js",
    "test:software-status": "node test/software-status.test.js",
    "dist": "electron-builder",
    "test:ui": "electron test/ui.cjs"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.batona.pc",
    "productName": "Batona PC",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "access-client.js",
      "software-status.js",
      "codex-bridge.js",
      "dir-service.js",
      "dsh-launcher.js",
      "preload.js",
      "renderer/**/*",
      "tunnel/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Batona PC"
    }
  }
}
